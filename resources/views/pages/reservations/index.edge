
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Réservation de matériel</title>
</head>
<body>
  <h1>Réservation de matériel</h1>
  
    @if (flashMessages.has('success'))
    <p>{{ flashMessages.get('success') }}</p>
    @endif

    @if (flashMessages.has('error'))
    <p>{{ flashMessages.get('error') }}</p>
    @endif

  <h2>Nouvelle réservation</h2>

  <form action="/reservations" method="POST">
    {{ csrfField() }}

    <div>
      <label for="material_id">Matériel à réserver</label>
      <select id="material_id" name="material_id" required>
        <option value="">Choisir un matériel</option>
        @each (material in materials)
          <option value="{{ material.id }}">
            {{ material.name }}
          </option>
        @endeach
      </select>
    </div>

    <p id="availability-message">
      Choisissez un matériel et les dates pour connaître la disponibilité.
    </p>

    <div>
      <label for="quantity">Quantité à réserver</label>
      <input
        type="number"
        id="quantity"
        name="quantity"
        min="1"
        value="1"
        required
      >
    </div>

    <div>
      <label for="borrower_name">Nom du demandeur</label>
      <input
        type="text"
        id="borrower_name"
        name="borrower_name"
        required
      >
    </div>

    <div>
      <label for="start_date">Date de début</label>
      <input type="date" id="start_date" name="start_date" required>
    </div>

    <div>
      <label for="end_date">Date de fin</label>
      <input type="date" id="end_date" name="end_date" required>
    </div>

    <button type="submit">Réserver le matériel</button>
  </form>

  <hr>

  <h2>Réservations enregistrées</h2>

  @if (reservations.length === 0)
    <p>Aucune réservation pour le moment.</p>
  @else
    <ul>
      @each (reservation in reservations)
        <li>
          Matériel n° {{ reservation.materialId }}
          — Quantité : {{ reservation.quantity }}
          — Réservé par {{ reservation.borrowerName }}
          — Du {{ reservation.startDate.toISODate() }} au {{ reservation.endDate.toISODate() }}
          — Statut : {{ reservation.status }}
        </li>
      @endeach
    </ul>
  @endif

  <p><a href="/materials">Retour à la gestion du matériel</a></p>


  <script>
    const materialInput = document.getElementById('material_id')
    const startDateInput = document.getElementById('start_date')
    const endDateInput = document.getElementById('end_date')
    const quantityInput = document.getElementById('quantity')
    const availabilityMessage = document.getElementById('availability-message')

    async function updateAvailability() {
      const materialId = materialInput.value
      const startDate = startDateInput.value
      const endDate = endDateInput.value

      if (!materialId || !startDate || !endDate) {
        availabilityMessage.textContent =
          'Choisissez un matériel et les dates pour connaître la disponibilité.'
        quantityInput.max = ''
        quantityInput.disabled = false
        return
      }

      if (endDate < startDate) {
        availabilityMessage.textContent =
          'La date de fin doit être postérieure ou égale à la date de début.'
        quantityInput.max = ''
        quantityInput.disabled = false
        return
      }

      try {
        const params = new URLSearchParams({
          material_id: materialId,
          start_date: startDate,
          end_date: endDate,
        })

        const response = await fetch(
          `/reservations/availability?${params.toString()}`
        )

        const data = await response.json()

        if (!response.ok) {
          availabilityMessage.textContent =
            data.message || 'Impossible de vérifier la disponibilité.'
          quantityInput.max = ''
          quantityInput.disabled = false
          return
        }

        
        if (data.availableQuantity === 0) {
          availabilityMessage.textContent =
            'Aucun exemplaire disponible sur cette période.'

          quantityInput.disabled = true
          quantityInput.max = ''
          quantityInput.value = '1'
          return
        }

        availabilityMessage.textContent =
          `Quantité disponible sur cette période : ${data.availableQuantity}`

        quantityInput.disabled = false
        quantityInput.max = data.availableQuantity

        if (Number(quantityInput.value) > data.availableQuantity) {
          quantityInput.value = data.availableQuantity
        }



      } catch (error) {
        availabilityMessage.textContent =
          'Erreur lors de la vérification de la disponibilité.'
        quantityInput.max = ''
        quantityInput.disabled = false
      }
    }

    materialInput.addEventListener('change', updateAvailability)
    startDateInput.addEventListener('change', updateAvailability)
    endDateInput.addEventListener('change', updateAvailability)
  </script>



</body>
</html>
