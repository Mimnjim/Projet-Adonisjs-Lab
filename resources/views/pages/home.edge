@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--ok);">
          <span class="dot"></span>
          Plateforme de prêt
        </span>
      </div>

      <div class="pc-lead">Le bon matériel, au bon moment.</div>

      <p class="pc-para">
        Consultez les équipements disponibles et réservez simplement le matériel
        dont vous avez besoin pour vos projets.
      </p>

      <div class="home-actions">
        <a class="home-action home-action--primary" href="/materials">
          <span>
            <strong>Explorer le matériel</strong>
            <small>Voir les équipements disponibles</small>
          </span>
          @svg('lucide:arrow-up-right', { width: 18, height: 18 })
        </a>
        <a class="home-action" href="/reservations">
          <span>
            <strong>Gérer les réservations</strong>
            <small>Consulter ou créer une réservation</small>
          </span>
          @svg('lucide:arrow-up-right', { width: 18, height: 18 })
        </a>
      </div>

      <div class="home-features">
        <span><span class="home-feature__dot"></span> Disponibilités en un coup d’œil</span>
        <span><span class="home-feature__dot"></span> Réservation rapide</span>
      </div>
    </article>
  </div>
@end
