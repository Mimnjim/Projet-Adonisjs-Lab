
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Gestion du matériel</title>
</head>
<body>
  <h1>Gestion du matériel</h1>
  @if (flashMessages.has('error'))
    <div style="padding: 12px; margin: 12px 0; background: #fee2e2; color: #991b1b; border: 1px solid #fca5a5; border-radius: 6px;">
      {{ flashMessages.get('error') }}
    </div>
  @endif

  @if (flashMessages.has('success'))
    <div style="padding: 12px; margin: 12px 0; background: #dcfce7; color: #166534; border: 1px solid #86efac; border-radius: 6px;">
      {{ flashMessages.get('success') }}
    </div>
  @endif

  <h2>Ajouter du matériel</h2>

  <form action="/materials" method="POST">
    {{ csrfField() }}
    <div>
      <label for="name">Nom du matériel</label>
      <input
        type="text"
        id="name"
        name="name"
        placeholder="Ex. : Appareil photo Canon"
        required
      >
    </div>

    <div>
      <label for="category">Catégorie</label>
      <input
        type="text"
        id="category"
        name="category"
        placeholder="Ex. : Photo"
        required
      >
    </div>

    <div>
      <label for="description">Description</label>
      <textarea
        id="description"
        name="description"
        placeholder="Décris le matériel (facultatif)"
      ></textarea>
    </div>

    <div>
      <label for="quantity">Quantité</label>
      <input
        type="number"
        id="quantity"
        name="quantity"
        min="1"
        value="1"
        required
      >
    </div>

    <button type="submit">Ajouter le matériel</button>
  </form>

  <hr>

  <h2>Matériel disponible</h2>

  @if (materials.length === 0)
    <p>Aucun matériel enregistré pour le moment.</p>
  @else
    <ul>
      @each (material in materials)
        <li>
          <strong>{{ material.name }}</strong>
          — Catégorie : {{ material.category }}
          — Quantité : {{ material.quantity }}

          @if (material.description)
            <p>{{ material.description }}</p>
          @endif
          
        <form action="/materials/{{ material.id }}/delete" method="POST">
            {{ csrfField() }}
            <button type="submit" onclick="return confirm('Voulez-vous vraiment supprimer ce matériel ?')">
                Supprimer
            </button>
        </form>

        <a href="/materials/{{ material.id }}/edit">
          Modifier
        </a>

        </li>
      @endeach
    </ul>
  @endif
</body>
</html>
